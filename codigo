// ============================================================
//  COBRA NO MATO  (versao "Campo Minado" em C) 
// ============================================================
//  COMO JOGAR (formato: acao linha coluna):
//    a 3 4  -> abrir a moita da linha 3, coluna 4
//    m 2 5  -> marcar/desmarcar moita suspeita (P)
// ============================================================

#include <stdio.h>   // printf, scanf, arquivos (fopen, fgets, fprintf, fscanf)
#include <stdlib.h>  // rand, srand, exit
#include <time.h>    // time (semente do sorteio)
#include <ctype.h>   // tolower (aceita 'A' e 'a')

// ----------constantes ----------
#define TAM 8                      // mato de 8x8
#define NUM_COBRAS 10              // cobras escondidas
#define ARQ_HISTORIA "historia.txt" // arquivo que SERA LIDO
#define ARQ_RANKING  "ranking.txt"  // arquivo que SERA ESCRITO e LIDO
#define MAX_RANKING 100            // maximo de registros lidos do ranking
#define TOP 5                      // quantos aparecem no ranking

// Estados possiveis de uma jogada (deixa o codigo mais legivel)
#define CONTINUA 0
#define PERDEU   1
#define VENCEU   2

// ----------STRUCTS----------

// Guarda uma posicao do mato (linha e coluna).
// Ela sera usada DENTRO da struct Jogador (struct aninhada).
typedef struct {
    int linha;
    int coluna;
} Coordenada;

// Cada "moita" do mato tem 4 informacoes juntas numa caixinha so.
typedef struct {
    int temCobra;   // 1 = tem cobra | 0 = nao tem
    int aberta;     // 1 = ja foi aberta
    int marcada;    // 1 = jogador marcou como suspeita
    int vizinhas;   // quantas cobras existem ao redor
} Moita;

// Dados do jogador.
// "ultimaJogada" e uma struct DENTRO de outra struct, NÃO ESQUECER.
// Para acessar: jogador.ultimaJogada.linha
typedef struct {
    char nome[30];
    int pontos;
    int jogadas;
    Coordenada ultimaJogada;   // <-- struct aninhada
} Jogador;

// Uma linha do ranking (lida do arquivo ranking.txt)
typedef struct {
    char nome[30];
    int pontos;
    char resultado[10];   // "VENCEU" ou "PERDEU"
} Registro;

// uma matriz pra Moita.
Moita mato[TAM][TAM];

// ============================================================
//  FUNCOES AUXILIARES
// ============================================================

// Limpa o que sobrou no teclado (evita loop infinito se digitar errado)
void limparBuffer() {
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
}

// --------Preparando o matagal----------
void inicializarMato() {
    Moita vazia = {0, 0, 0, 0};   // moita com tudo zerado
    for (int i = 0; i < TAM; i++) {
        for (int j = 0; j < TAM; j++) {
            mato[i][j] = vazia;   // copia a moita vazia para cada posicao
        }
    }
}

// ----------Escondendo as cobras----------
void sortearCobras() {
    int colocadas = 0;
    while (colocadas < NUM_COBRAS) {
        int l = rand() % TAM;   // linha sorteada
        int c = rand() % TAM;   // coluna sorteada
        // so coloca se ainda nao tiver cobra (evita repetir o lugar)
        if (mato[l][c].temCobra == 0) {
            mato[l][c].temCobra = 1;
            colocadas++;
        }
    }
}

// ----------Contando cobras ao redor de uma moita ----------
int contarVizinhas(int l, int c) {
    int total = 0;
    // di e dj de -1 a +1 visitam as 8 casas ao redor
    for (int di = -1; di <= 1; di++) {
        for (int dj = -1; dj <= 1; dj++) {
            int nl = l + di;
            int nc = c + dj;
            // Enfase no so conta se a vizinha esta DENTRO do mato
            if (nl >= 0 && nl < TAM && nc >= 0 && nc < TAM) {
                total += mato[nl][nc].temCobra;
            }
        }
    }
    return total;
}

// ----------Calculando o numero de todas as moitas----------
void calcularNumeros() {
    for (int i = 0; i < TAM; i++) {
        for (int j = 0; j < TAM; j++) {
            mato[i][j].vizinhas = contarVizinhas(i, j);
        }
    }
}

// Prepara tudo para uma nova partida (junta os 3 passos acima)
void prepararPartida() {
    inicializarMato();
    sortearCobras();
    calcularNumeros();
}

// ---------- Abrir moita (RECURSIVA) ----------
void abrirMoita(int l, int c) {
    // saiu do mato? para.
    if (l < 0 || l >= TAM || c < 0 || c >= TAM) return;
    // ja aberta ou marcada? para.
    if (mato[l][c].aberta || mato[l][c].marcada) return;

    mato[l][c].aberta = 1;

    // se nao tem cobra por perto, abre as 8 vizinhas (efeito cascata)
    if (mato[l][c].vizinhas == 0) {
        for (int di = -1; di <= 1; di++) {
            for (int dj = -1; dj <= 1; dj++) {
                abrirMoita(l + di, c + dj);
            }
        }
    }
}

// ----------Desenho do matagal----------
// mostrarTudo = 1 revela as cobras (usado no fim do jogo)
void mostrarMato(int mostrarTudo) {
    printf("\n     ");
    for (int j = 0; j < TAM; j++) printf("%d ", j + 1);
    printf("\n     ");
    for (int j = 0; j < TAM; j++) printf("- ");
    printf("\n");

    for (int i = 0; i < TAM; i++) {
        printf(" %d | ", i + 1);
        for (int j = 0; j < TAM; j++) {
            if (mostrarTudo && mato[i][j].temCobra) {
                printf("@ ");                          // cobra revelada
            } else if (mato[i][j].marcada) {
                printf("P ");                          // marcada
            } else if (!mato[i][j].aberta) {
                printf("# ");                          // fechada
            } else if (mato[i][j].vizinhas == 0) {
                printf(". ");                          // limpa
            } else {
                printf("%d ", mato[i][j].vizinhas);    // numero
            }
        }
        printf("\n");
    }
    printf("\n");
}

// ----------Pontuação----------

// Conta quantas moitas SEGURAS ja foram abertas
int contarAbertas() {
    int total = 0;
    for (int i = 0; i < TAM; i++) {
        for (int j = 0; j < TAM; j++) {
            if (mato[i][j].aberta && !mato[i][j].temCobra) total++;
        }
    }
    return total;
}

// Venceu = abriu todas as moitas sem cobra
int venceu() {
    return contarAbertas() == (TAM * TAM - NUM_COBRAS);
}

// Pontos = 10 por moita segura aberta (+100 de bonus se vencer)
// Recebe o jogador por PONTEIRO (*) para poder alterar os pontos dele.
void calcularPontos(Jogador *j, int resultado) {
    j->pontos = contarAbertas() * 10;
    if (resultado == VENCEU) {
        j->pontos += 100;
    }
}

// ============================================================
//  JOGADA
// ============================================================

// ----------Ler Jogadas----------
// Devolve 1 se a jogada e valida, 0 se nao for.
// Preenche a acao e a Coordenada por ponteiro.
int lerJogada(char *acao, Coordenada *pos) {
    int lidos = scanf(" %c %d %d", acao, &pos->linha, &pos->coluna);

    if (lidos == EOF) exit(0);   // acabou a entrada: encerra o programa
    if (lidos != 3) {            // digitou algo errado
        limparBuffer();
        return 0;
    }

    *acao = tolower(*acao);      // 'A' vira 'a'
    pos->linha--;                // jogador digita 1..8, matriz usa 0..7
    pos->coluna--;

    // posicao fora do mato?
    if (pos->linha < 0 || pos->linha >= TAM ||
        pos->coluna < 0 || pos->coluna >= TAM) {
        return 0;
    }
    return 1;
}

// ----------Executar a jogada ----------
// Devolve CONTINUA, PERDEU ou VENCEU
int executarJogada(char acao, Coordenada pos, Jogador *j) {
    Moita *m = &mato[pos.linha][pos.coluna];   // atalho para a moita escolhida

    j->ultimaJogada = pos;   // guarda na struct aninhada (copia linha e coluna)

    if (acao == 'm') {
        // marcar/desmarcar so vale para moita fechada
        if (!m->aberta) m->marcada = !m->marcada;
        return CONTINUA;
    }

    if (acao == 'a') {
        if (m->marcada) {
            printf("Essa moita esta marcada! Desmarque antes.\n");
            return CONTINUA;
        }
        j->jogadas++;   // conta mais uma jogada

        if (m->temCobra) {
            m->aberta = 1;
            return PERDEU;
        }
        abrirMoita(pos.linha, pos.coluna);
        if (venceu()) return VENCEU;
        return CONTINUA;
    }

    printf("Comando invalido! Use 'a' ou 'm'.\n");
    return CONTINUA;
}

// ============================================================
//  ARQUIVOS
// ============================================================

// ----------LER a historia do arquivo (fgets)----------
void exibirHistoria() {
    FILE *arq = fopen(ARQ_HISTORIA, "r");   // "r" = somente leitura
    char linha[200];

    printf("\n");
    if (arq == NULL) {
        // se o arquivo nao existir, mostra um texto padrao
        printf("Atravesse o mato sem ser picado pelas cobras!\n");
        return;
    }
    // fgets le uma linha por vez, ate o fim do arquivo (devolve NULL)
    while (fgets(linha, sizeof(linha), arq) != NULL) {
        printf("%s", linha);
    }
    fclose(arq);   // sempre fechar o arquivo
}

// ---------- SALVAR no ranking (fprintf) ----------
void salvarRanking(Jogador j, int resultado) {
    FILE *arq = fopen(ARQ_RANKING, "a");   // "a" = acrescenta no final
    if (arq == NULL) {
        printf("Nao foi possivel salvar o ranking.\n");
        return;
    }
    // escreve uma linha no formato: nome pontos resultado
    fprintf(arq, "%s %d %s\n", j.nome, j.pontos,
            resultado == VENCEU ? "VENCEU" : "PERDEU");
    fclose(arq);
}

// ----------LER e mostrar o ranking (fscanf + ordenacao)----------
void mostrarRanking() {
    Registro lista[MAX_RANKING];   // VETOR de structs
    int total = 0;

    FILE *arq = fopen(ARQ_RANKING, "r");
    if (arq == NULL) {
        printf("\nAinda nao ha ranking. Jogue uma partida!\n");
        return;
    }

    // fscanf devolve quantos valores leu; 3 = linha completa e valida
    while (total < MAX_RANKING &&
           fscanf(arq, "%29s %d %9s", lista[total].nome,
                  &lista[total].pontos, lista[total].resultado) == 3) {
        total++;
    }
    fclose(arq);

    // Ordenacao Bubble Sort: maior pontuacao primeiro
    for (int i = 0; i < total - 1; i++) {
        for (int k = 0; k < total - 1 - i; k++) {
            if (lista[k].pontos < lista[k + 1].pontos) {
                Registro temp = lista[k];       // troca de posicao
                lista[k] = lista[k + 1];
                lista[k + 1] = temp;
            }
        }
    }

    printf("\n===== RANKING (TOP %d) =====\n", TOP);
    for (int i = 0; i < total && i < TOP; i++) {
        printf("%d. %-15s %4d pts  (%s)\n", i + 1, lista[i].nome,
               lista[i].pontos, lista[i].resultado);
    }
}

// ============================================================
//  PARTIDA E MENU
// ============================================================

// ----------Partida completa ----------
void jogarPartida() {
    Jogador jogador;
    char acao;
    Coordenada pos;
    int estado = CONTINUA;

    // Dados iniciais do jogador
    printf("\nDigite seu nome (sem espacos): ");
    scanf(" %29s", jogador.nome);
    jogador.pontos = 0;
    jogador.jogadas = 0;
    jogador.ultimaJogada.linha = -1;    // acessando a struct aninhada
    jogador.ultimaJogada.coluna = -1;

    exibirHistoria();     // le historia.txt
    prepararPartida();    // cria o mato
    printf("\nHa %d cobras escondidas! Comandos: a (abrir) | m (marcar)\n", NUM_COBRAS);

    // laco da partida: repete ate perder ou vencer
    while (estado == CONTINUA) {
        mostrarMato(0);
        printf("Sua jogada (ex: a 3 4): ");

        if (!lerJogada(&acao, &pos)) {
            printf("Jogada invalida! Use: acao linha coluna (1 a %d)\n", TAM);
            continue;
        }
        estado = executarJogada(acao, pos, &jogador);
    }

    // fim da partida
    mostrarMato(1);
    if (estado == VENCEU) {
        printf("PARABENS! Voce atravessou o mato sem tomar picada!\n");
    } else {
        printf("SSSSS! Voce pisou numa COBRA! Fim de jogo!\n");
    }

    calcularPontos(&jogador, estado);
    printf("%s, voce fez %d pontos em %d jogadas.\n",
           jogador.nome, jogador.pontos, jogador.jogadas);

    salvarRanking(jogador, estado);   // grava no arquivo
    mostrarRanking();                 // mostra o ranking atualizado
}

void exibirMenu() {
    printf("\n===== COBRA NO MATO =====\n");
    printf("1 - Jogar\n");
    printf("2 - Ver ranking\n");
    printf("3 - Sair\n");
    printf("Escolha: ");
}

// ----------Main = "maestro"----------
// So mostra o menu e chama as funcoes. Nenhuma regra do jogo fica aqui.
int main() {
    int opcao = 0;
    srand(time(NULL));   // semente do sorteio (cobras mudam a cada jogo)

    while (opcao != 3) {
        exibirMenu();
        if (scanf("%d", &opcao) != 1) {   // digitou letra em vez de numero
            limparBuffer();
            opcao = 0;
        }

        switch (opcao) {
            case 1: jogarPartida();  break;
            case 2: mostrarRanking(); break;
            case 3: printf("Ate a proxima!\n"); break;
            default: printf("Opcao invalida!\n");
        }
    }
    return 0;
}
